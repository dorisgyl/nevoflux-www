---
export const prerender = true;

import Layout from '~/layouts/Layout.astro';
import NavBar from '~/components/NavBar.astro';
import Footer from '~/components/Footer.astro';
import { getLocale, getUI, getStaticPaths as getI18nStaticPaths } from '~/utils/i18n';

export function getStaticPaths() {
  return getI18nStaticPaths();
}

const locale = getLocale(Astro.url);
const ui = getUI(locale);
---

<Layout title={`${ui.device.title} · ${ui.site.title}`} description={ui.device.subtitle}>
  <NavBar />
  <main class="container flex min-h-screen items-center justify-center py-32">
    <div
      id="device-root"
      class="border-dark/10 bg-surface/30 w-full max-w-sm rounded-2xl border p-8"
      data-approved={ui.device.approved}
      data-denied={ui.device.denied}
      data-invalid={ui.device.invalid}
      data-error={ui.device.error}
      data-redirecting={ui.device.redirecting}
    >
      <h1 class="text-2xl font-bold text-dark">{ui.device.title}</h1>
      <p class="mt-2 text-sm text-subtle">{ui.device.subtitle}</p>

      <div id="device-actions" class="mt-6 hidden space-y-3">
        <label for="user-code" class="block text-sm font-medium text-dark"
          >{ui.device.codeLabel}</label
        >
        <input
          id="user-code"
          type="text"
          autocomplete="off"
          spellcheck="false"
          class="border-dark/15 w-full rounded-lg border px-4 py-2.5 text-center font-mono text-lg uppercase tracking-widest outline-none focus:border-accent"
        />
        <p class="text-xs text-muted">{ui.device.instruction}</p>
        <button
          id="approve"
          class="w-full rounded-lg bg-accent px-4 py-2.5 text-sm font-medium text-white transition-colors hover:bg-accent-hover"
          >{ui.device.approve}</button
        >
        <button
          id="deny"
          class="border-dark/15 hover:border-dark/30 w-full rounded-lg border px-4 py-2.5 text-sm font-medium text-subtle transition-colors"
          >{ui.device.deny}</button
        >
      </div>

      <p id="device-status" class="mt-6 hidden text-sm"></p>
    </div>
  </main>
  <Footer />
</Layout>

<script>
  import { authClient } from '~/lib/auth-client';

  const root = document.getElementById('device-root');
  const actions = document.getElementById('device-actions');
  const status = document.getElementById('device-status');
  const codeInput = document.getElementById('user-code') as HTMLInputElement | null;
  const msg = (k: string) => (root?.dataset[k] ?? '') as string;

  const userCode = (new URLSearchParams(window.location.search).get('user_code') ?? '').trim();
  if (codeInput && userCode) codeInput.value = userCode;

  function showStatus(text: string, ok: boolean) {
    if (!status) return;
    status.textContent = text;
    status.className = 'mt-6 text-sm ' + (ok ? 'text-accent' : 'text-red-500');
    status.classList.remove('hidden');
  }

  // Claim the code for the signed-in user. better-auth's approve endpoint
  // rejects an unclaimed code ("device_code_not_claimed"); visiting the verify
  // endpoint (GET /device) while authenticated associates userId with the code.
  async function claim(code: string) {
    if (!code) return;
    try {
      await fetch(`/api/auth/device?user_code=${encodeURIComponent(code)}`, {
        credentials: 'include',
      });
    } catch {
      /* best-effort; approve/deny below surfaces the real error */
    }
  }

  function goLogin() {
    const back = '/device' + (userCode ? '?user_code=' + encodeURIComponent(userCode) : '');
    showStatus(msg('redirecting'), true);
    window.location.href = '/login?redirect=' + encodeURIComponent(back);
  }

  async function respond(action: 'approve' | 'deny') {
    const code = (codeInput?.value ?? '').trim();
    if (!code) return;
    try {
      await claim(code); // approve requires userId to be set on the code first
      const res = await fetch(`/api/auth/device/${action}`, {
        method: 'POST',
        credentials: 'include',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ userCode: code }),
      });
      if (res.ok) {
        actions?.classList.add('hidden');
        showStatus(action === 'approve' ? msg('approved') : msg('denied'), true);
      } else if (res.status === 401) {
        goLogin(); // session expired mid-flow
      } else {
        // Surface the server's actual reason (e.g. expired) instead of guessing.
        let reason = '';
        try {
          const body = (await res.json()) as { error_description?: string };
          reason = body?.error_description ?? '';
        } catch {
          /* no JSON body */
        }
        showStatus(reason || msg('invalid'), false);
      }
    } catch {
      showStatus(msg('error'), false);
    }
  }

  async function init() {
    const { data } = await authClient.getSession();
    if (!data) {
      goLogin(); // not signed in — log in and return here with the code preserved
      return;
    }
    actions?.classList.remove('hidden');
    await claim((codeInput?.value ?? '').trim()); // proactively claim the prefilled code
  }

  document.getElementById('approve')?.addEventListener('click', () => respond('approve'));
  document.getElementById('deny')?.addEventListener('click', () => respond('deny'));
  init();
</script>
