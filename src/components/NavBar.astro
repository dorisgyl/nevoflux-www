---
import { getLocale, getUI, getPath, getAlternateUrl } from '~/utils/i18n';
import { GITHUB_URL, DISCORD_URL, X_URL, DOCS_URL } from '~/constants';
import Logo from './Logo.astro';

const locale = getLocale(Astro.url);
const ui = getUI(locale);
const alternateUrl = getAlternateUrl(Astro.url);
const docsUrl = `${DOCS_URL}/${locale}/docs`;

// Rendered twice: inline on lg+, stacked inside the drawer below lg. The full
// bar needs ~800px before the login slot starts squeezing, so md is too early.
const links = [
  { href: docsUrl, label: ui.nav.documentation },
  // The fragment has to be appended after getPath: passing it through would
  // come back as `/#features/`, with the trailing slash breaking the anchor.
  { href: `${getPath(locale, '/')}#features`, label: ui.nav.features },
  { href: getPath(locale, '/release-notes'), label: ui.nav.releaseNotes },
  { href: getPath(locale, '/packs'), label: ui.nav.packs },
];

const socials = [
  {
    href: X_URL,
    label: ui.nav.x,
    path: 'M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z',
  },
  {
    href: DISCORD_URL,
    label: ui.nav.discord,
    path: 'M20.317 4.3698a19.7913 19.7913 0 00-4.8851-1.5152.0741.0741 0 00-.0785.0371c-.211.3753-.4447.8648-.6083 1.2495-1.8447-.2762-3.68-.2762-5.4868 0-.1636-.3933-.4058-.8742-.6177-1.2495a.077.077 0 00-.0785-.037 19.7363 19.7363 0 00-4.8852 1.515.0699.0699 0 00-.0321.0277C.5334 9.0458-.319 13.5799.0992 18.0578a.0824.0824 0 00.0312.0561c2.0528 1.5076 4.0413 2.4228 5.9929 3.0294a.0777.0777 0 00.0842-.0276c.4616-.6304.8731-1.2952 1.226-1.9942a.076.076 0 00-.0416-.1057c-.6528-.2476-1.2743-.5495-1.8722-.8923a.077.077 0 01-.0076-.1277c.1258-.0943.2517-.1923.3718-.2914a.0743.0743 0 01.0776-.0105c3.9278 1.7933 8.18 1.7933 12.0614 0a.0739.0739 0 01.0785.0095c.1202.099.246.1981.3728.2924a.077.077 0 01-.0066.1276 12.2986 12.2986 0 01-1.873.8914.0766.0766 0 00-.0407.1067c.3604.698.7719 1.3628 1.225 1.9932a.076.076 0 00.0842.0286c1.961-.6067 3.9495-1.5219 6.0023-3.0294a.077.077 0 00.0313-.0552c.5004-5.177-.8382-9.6739-3.5485-13.6604a.061.061 0 00-.0312-.0286zM8.02 15.3312c-1.1825 0-2.1569-1.0857-2.1569-2.419 0-1.3332.9555-2.4189 2.157-2.4189 1.2108 0 2.1757 1.0952 2.1568 2.419 0 1.3332-.9555 2.4189-2.1569 2.4189zm7.9748 0c-1.1825 0-2.1569-1.0857-2.1569-2.419 0-1.3332.9554-2.4189 2.1569-2.4189 1.2108 0 2.1757 1.0952 2.1568 2.419 0 1.3332-.946 2.4189-2.1568 2.4189z',
  },
  {
    href: GITHUB_URL,
    label: ui.nav.github,
    path: 'M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z',
  },
];

const iconLink =
  'border-dark/10 hover:border-accent/30 inline-flex items-center justify-center rounded-lg border text-subtle transition-colors hover:text-accent';
const langLink =
  'hover:bg-accent/5 inline-flex items-center gap-1 rounded-md text-xs font-medium text-muted transition-colors hover:text-accent';
---

<nav class="border-dark/10 bg-paper/80 fixed top-0 z-50 w-full border-b backdrop-blur-md">
  <div class="container flex h-16 items-center justify-between gap-3">
    <a href={getPath(locale, '/')} class="flex shrink-0 items-center gap-2.5">
      <Logo size={28} />
      <span class="text-lg font-bold tracking-tight">
        <span class="text-accent">Nevo</span>Flux
      </span>
    </a>

    <!-- Inline navigation (lg and up) -->
    <div class="hidden items-center gap-4 lg:flex xl:gap-6">
      {
        links.map((link) => (
          <a
            href={link.href}
            class="text-sm font-medium text-subtle transition-colors hover:text-accent"
          >
            {link.label}
          </a>
        ))
      }

      <a href={alternateUrl} class={`${langLink} px-2 py-1`} title={ui.lang.switchTo}>
        <svg
          class="h-3.5 w-3.5"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <circle cx="12" cy="12" r="10"></circle>
          <path d="M2 12h20"></path>
          <path
            d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"
          ></path>
        </svg>
        {ui.lang.switchTo}
      </a>

      {
        socials.map((social) => (
          <a
            href={social.href}
            class={`${iconLink} p-2`}
            target="_blank"
            rel="noopener noreferrer"
            aria-label={social.label}
            title={social.label}
          >
            <svg class="h-4 w-4" viewBox="0 0 24 24" fill="currentColor">
              <path d={social.path} />
            </svg>
          </a>
        ))
      }

      <!-- Auth state (resolved client-side so prerendered pages stay static) -->
      <span
        id="nav-auth"
        data-nav-auth
        data-logout-label={ui.auth.logout}
        class="whitespace-nowrap text-sm font-medium text-subtle"
      >
        <a href={getPath(locale, '/login')} class="transition-colors hover:text-accent">
          {ui.auth.login}
        </a>
      </span>
    </div>

    <!-- Drawer toggle (below lg) -->
    <button
      id="nav-toggle"
      type="button"
      class={`${iconLink} p-2 lg:hidden`}
      aria-controls="nav-menu"
      aria-expanded="false"
      aria-label={ui.nav.menu}
    >
      <svg
        data-nav-icon="open"
        class="h-5 w-5"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
      >
        <path d="M4 7h16"></path>
        <path d="M4 12h16"></path>
        <path d="M4 17h16"></path>
      </svg>
      <svg
        data-nav-icon="close"
        class="hidden h-5 w-5"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
      >
        <path d="M6 6l12 12"></path>
        <path d="M18 6L6 18"></path>
      </svg>
    </button>
  </div>

  <!-- Drawer panel (below lg) -->
  <div id="nav-menu" class="border-dark/10 bg-paper/95 hidden border-t backdrop-blur-md lg:hidden">
    <div class="container flex flex-col gap-1 py-3">
      {
        links.map((link) => (
          <a
            href={link.href}
            class="hover:bg-accent/5 rounded-lg px-3 py-2.5 text-base font-medium text-subtle transition-colors hover:text-accent"
          >
            {link.label}
          </a>
        ))
      }

      <div class="border-dark/10 mt-2 flex items-center gap-3 border-t pt-3">
        <a href={alternateUrl} class={`${langLink} px-2 py-1.5`} title={ui.lang.switchTo}>
          <svg
            class="h-3.5 w-3.5"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <circle cx="12" cy="12" r="10"></circle>
            <path d="M2 12h20"></path>
            <path
              d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"
            ></path>
          </svg>
          {ui.lang.switchTo}
        </a>

        {
          socials.map((social) => (
            <a
              href={social.href}
              class={`${iconLink} p-2`}
              target="_blank"
              rel="noopener noreferrer"
              aria-label={social.label}
              title={social.label}
            >
              <svg class="h-4 w-4" viewBox="0 0 24 24" fill="currentColor">
                <path d={social.path} />
              </svg>
            </a>
          ))
        }

        <span
          data-nav-auth
          data-logout-label={ui.auth.logout}
          class="ml-auto whitespace-nowrap text-sm font-medium text-subtle"
        >
          <a href={getPath(locale, '/login')} class="transition-colors hover:text-accent">
            {ui.auth.login}
          </a>
        </span>
      </div>
    </div>
  </div>
</nav>

<script>
  const toggle = document.getElementById('nav-toggle');
  const menu = document.getElementById('nav-menu');

  if (toggle && menu) {
    const openIcon = toggle.querySelector('[data-nav-icon="open"]');
    const closeIcon = toggle.querySelector('[data-nav-icon="close"]');

    const setOpen = (open: boolean) => {
      menu.classList.toggle('hidden', !open);
      openIcon?.classList.toggle('hidden', open);
      closeIcon?.classList.toggle('hidden', !open);
      toggle.setAttribute('aria-expanded', String(open));
    };

    toggle.addEventListener('click', () => {
      setOpen(menu.classList.contains('hidden'));
    });

    // Same-page anchors (#features) don't reload, so close the drawer manually.
    menu.querySelectorAll('a').forEach((link) => {
      link.addEventListener('click', () => setOpen(false));
    });

    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && !menu.classList.contains('hidden')) {
        setOpen(false);
        toggle.focus();
      }
    });

    // Widening past the lg breakpoint reveals the inline nav; drop the drawer
    // so it can't reappear stuck-open when the viewport narrows again.
    const desktop = window.matchMedia('(min-width: 1024px)');
    desktop.addEventListener('change', (event) => {
      if (event.matches) setOpen(false);
    });
  }
</script>

<script>
  import { authClient } from '~/lib/auth-client';

  const slots = document.querySelectorAll<HTMLElement>('[data-nav-auth]');
  if (slots.length) {
    const { data } = await authClient.getSession();
    if (data?.user) {
      const user = data.user;
      const name = user.name || user.email || '';

      slots.forEach((slot) => {
        const logoutLabel = slot.dataset.logoutLabel ?? 'Log out';
        const alignment = slot.classList.contains('ml-auto') ? ' ml-auto' : '';
        slot.textContent = '';
        slot.className = `inline-flex items-center gap-2 text-sm font-medium text-subtle${alignment}`;

        let avatar: HTMLElement;
        if (user.image) {
          const img = document.createElement('img');
          img.src = user.image;
          img.alt = name;
          img.referrerPolicy = 'no-referrer';
          img.className = 'border-dark/10 h-7 w-7 rounded-full border object-cover';
          avatar = img;
        } else {
          const fallback = document.createElement('span');
          fallback.className =
            'bg-accent/10 text-accent flex h-7 w-7 items-center justify-center rounded-full text-xs font-semibold';
          fallback.textContent = (name.trim()[0] || '?').toUpperCase();
          avatar = fallback;
        }
        avatar.title = name;

        const logout = document.createElement('button');
        logout.className = 'transition-colors hover:text-accent';
        logout.textContent = logoutLabel;
        logout.addEventListener('click', async () => {
          await authClient.signOut();
          location.reload();
        });

        slot.appendChild(avatar);
        slot.appendChild(logout);
      });
    }
  }
</script>
